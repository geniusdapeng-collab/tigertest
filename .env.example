# Tiger model-required and intelligence profiles; never loaded automatically.
# Put actual credentials in a protected operator-owned file outside the checkout,
# then export these settings in the trusted CLI/MCP startup environment.
# Official alias mapping observed 2026-10-26: DeepSeek-V4.1-Flash-1017.
# deepseek-flash is an alias, not an immutable versioned model identifier.
LLM_BACKEND=api
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
# Operator contact email for direct SEC EDGAR verification. Leave blank if unavailable.
TIGER_SEC_CONTACT=
# us-public-intelligence-paper-v2 adds bounded registered-source acquisition,
# original-page/attachment capture, per-target evidence and immutable bundles.
# Legacy v1's fixed 14-topic collector remains only for historical replay.
# Text semantics always use the admitted DeepSeek client; no alternate model.
# Optional search providers are disabled unless trusted startup enables them.
TIGER_INTEL_BRAVE_API_KEY=
TIGER_INTEL_TAVILY_API_KEY=
TIGER_INTEL_EXA_API_KEY=
TIGER_INTEL_FRED_API_KEY=
# Legal SEC User-Agent identifying the operator/contact; blank means a gap.
# Do not invent a contact or reuse another person's identity.
TIGER_INTEL_SEC_USER_AGENT=
# Optional trusted startup inputs for a reviewed source policy and prior archive.
# Absolute operator-owned paths; never accepted in a business request JSON.
TIGER_INTEL_REGISTRY_FILE=
TIGER_INTEL_ARCHIVE_ROOT=
